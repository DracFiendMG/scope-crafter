# ScopeCrafter Environment Variables Configuration

# Server Port (default 3000)
PORT=3000
NODE_ENV=development

# Backboard SDK API Key (Targets: Best Use of Backboard)
# Obtain your free hackathon promo code or key at https://backboard.io
BACKBOARD_API_KEY=

# OpenRouter API Key (Targets: Best Use of Gemma)
# For zero-cost inference with google/gemma-4-26b-a4b-it:free
OPENROUTER_API_KEY=
